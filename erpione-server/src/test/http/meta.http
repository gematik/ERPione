import http-client.env.json

### DELEGATIONS-01
# read information about the ERPione service
POST {{host}}/delegations
Content-Type: application/json
Cookie: {{cookie}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "scope": ["openid"],
  "aud": "erpione-headless",
  "ttlSeconds": 900
}

### META-01
# read information about the ERPione service
GET {{host}}/info
Content-Type: application/json
#Cookie: {{cookie}}
#X-XSRF-TOKEN: {{xsrfToken}}
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..8bRF-I1FRryI9chUzF4qm2x3UYNWx9kD6-bM148pjCM

### META-02
# read information about the ERPione service
GET {{host}}/erp/meta
X-Actor: hygieia
Content-Type: application/json
apikey: {{apikey}}

### META-03
# perform a health check to the ERP-Fachdienst
GET {{host}}/erp/health
X-Actor: hygieia
Content-Type: application/json
apikey: {{apikey}}

### META-ACTORS-01
# read information about the ERPione service
GET {{host}}/actors
Content-Type: application/json
apikey: {{apikey}}

### META-ACTORS-02
# read the configuration of a specific actor
GET {{host}}/actors/hygieia
Content-Type: application/json
apikey: {{apikey}}

### META-ACTORS-03
# read the configuration of all actors of a specific role
GET {{host}}/actors?role=ncpeh
Content-Type: application/json
apikey: {{apikey}}

### META-ERP-01
# read the capability statement from erp-fachdienst
GET {{host}}/erp/vaduz/meta
Content-Type: application/json
apikey: {{apikey}}

### DEBUG-HEADERS
# read information about the ERPione service
GET {{host}}/debug/headers
Content-Type: application/json
Cookie: {{cookie}}
X-XSRF-TOKEN: {{xsrfToken}}
