import http-client.env.json


### FAKER-KBV-PHARM-PRESCRIPTION-01
# Fake Kbv-Bundle as FHIR+XML for pharmaceutical prescription
GET {{host}}/faker/kbv/pharmaceutical
Content-Type: application/json
Accept: application/fhir+xml

{
  "patient": {
    "type": "GKV",
    "kvnr": "K220635158",
    "birthDate": "02.12.1961"
  },
  "coverage": {
    "type": "PKV",
    "insurantState": "3"
  }
}

