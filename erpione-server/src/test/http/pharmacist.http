import http-client.env.json

@actor = Hygieia

@prescriptionId = 160.000.114.452.028.14
@accessCode = 94987df81433defd5731b31d84981bbbda5984cd7724bcce52538bf72e9326b1
@secret = 84a7b832393c069251c118923af0b0a5f64541673c9c1c55e6c1ff02960d8f32

### PHARM-CLAIM-01
# get information for a specific pharmacist
POST {{host}}/erp/{{prescriptionId}}/claim?ac={{accessCode}}
Content-Type: application/json
X-Actor: Erpione
Cookie: {{cookie}}
X-XSRF-TOKEN: {{xsrfToken}}

### PHARM-RETURN-01
# get information for a specific pharmacist
POST {{host}}/erp/{{actor}}/return/{{prescriptionId}}
Content-Type: application/json
apikey: {{apikey}}

### PHARM-ABORT-01
# try to abort/delete a prescription which was not yet claimed
# Note: the FD won't allow because pharmacy always requires a secret for this operation
DELETE {{host}}/erp/{{actor}}/abort/{{prescriptionId}}?ac={{accessCode}}
Content-Type: application/json
apikey: {{apikey}}

### PHARM-ABORT-02
# try to abort/delete a prescription which was claimed and the secret is known
DELETE {{host}}/erp/{{actor}}/abort/{{prescriptionId}}?ac={{accessCode}}&secret={{secret}}
Content-Type: application/json
apikey: {{apikey}}

### PHARM-DISPENSE-01
POST {{host}}/erp/{{actor}}/dispense/{{prescriptionId}}
Content-Type: application/json
apikey: {{apikey}}

