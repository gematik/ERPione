import http-client.env.json

@actor = Machaon
#@actor = Telesphorus
#@actor = Podaleirios

@prescriptionId = 160.000.114.599.334.28
@accessCode = 4b70929a3c6ee079fd4c00ad4aa70173be9de8f46e32e2be40892aad9d79763c

### DOC-PHARMACEUTICAL-PRESCRIBE-01
# prescribe a completly random pharmaceutical prescription
POST {{host}}/erp/pharmaceutical
Content-Type: application/json
x-actor: {{actor}}
#Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..FpFDepdGh9fsVsA4QopSU4Xd98qBBeW5LkT4VJT4GDM
Cookie: {{cookie}}
X-XSRF-TOKEN: {{xsrfToken}}

### DOC-PHARMACEUTICAL-PRESCRIBE-02
# prescribe pharmaceutical with json as a simple PZN prescription
POST {{host}}/erp/pharmaceutical
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

{
  "patient": {
    "type": "GKV",
    "kvnr": "X110614233",
    "name": {
      "prefix": "Prof. habil. Dr. med",
      "given": "Friedrich-Wilhelm-Karl-Gustav-Justus-Gotfried",
      "family": "Schaumberg-von-und-zu-Schaumburg-und-Radeberg"
    },
    "birthDate": "10.06.1986"
  },
  "coverage": {
    "type": "GKV"
  },
  "medicationRequest": {
    "note": "Hello World live von der Demo #2"
  }
}

### DOC-PHARMACEUTICAL-PRESCRIBE-03
# prescribe pharmaceutical with json as Freetext prescription
POST {{host}}/erp/pharmaceutical
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

{
  "patient": {
    "type": "GKV",
    "kvnr": "K030182229"
  },
  "coverage": {
    "type": "GKV"
  },
  "medication": {
    "type": "FREETEXT",
    "supplyForm": "Kautabletten",
    "standardSize": "N3",
    "freeText": "Metformin 850mg Tabletten N3"
  }
}

### DOC-PHARMACEUTICAL-PRESCRIBE-04
# prescribe pharmaceutical with json as Ingredient prescription
POST {{host}}/erp/pharmaceutical
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

{
  "patient": {
    "type": "GKV",
    "kvnr": "K030182229"
  },
  "coverage": {
    "type": "GKV"
  },
  "medication": {
