### DOC-PHARMACEUTICAL-PRESCRIBE-05
# prescribe pharmaceutical with json as Compounding prescription
POST {{host}}/erp/pharmaceutical
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

{
  "medication": {
    "type": "Rezeptur",
    "supplyForm": "GEL",
    "pzn": "10206346",
    "name": "Aluminiumchlorid-Hexahydrat",
    "freeText": "Viskose Aluminiumchlorid-Hexahydrat-Lösung 20 % (NRF 11.132.)"
  }
}

### DOC-PHARMACEUTICAL-PRESCRIBE-06
# prescribe pharmaceutical with xml
POST {{host}}/erp/pharmaceutical
Content-Type: application/fhir+xml
x-actor: {{actor}}
apikey: {{apikey}}

< /path/to/Beispiel_1_PZN.xml

### DOC-EVDGA-PRESCRIBE-01
# prescribe a completly random EVDGA
POST {{host}}/erp/evdga
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

### DOC-EVDGA-PRESCRIBE-02
# prescribe DIGA with xml
POST {{host}}/erp/evdga
Content-Type: application/fhir+xml
x-actor: {{actor}}
apikey: {{apikey}}

< /path/to/EVDGA_Bundle.xml

### DOC-ABORT-01
# abort/delete a prescription
DELETE {{host}}/erp/abort/{{prescriptionId}}
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

### DOC-ABORT-02
# abort/delete a prescription with a custom access code
DELETE {{host}}/erp/abort/{{prescriptionId}}?ac={{accessCode}}
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}

### DOC-ABORT-EXAMPLE-02
# abort/delete a prescription with a custom access code
DELETE {{host}}/erp/abort/160.000.114.599.332.34?ac=530d32c41dda8e3a9c71b14298e67c38762682df8efa67298231fa838d70fdf7
Content-Type: application/json
x-actor: {{actor}}
apikey: {{apikey}}